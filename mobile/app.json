{
  "expo": {
    "name": "Falcon Attendance",
    "slug": "falcon-attendance",
    "version": "1.0.7",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.falconinfo.attendance",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Falcon Attendance requires your location to verify you are inside the office premises during check-in and check-out.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.falconinfo.attendance",
      "versionCode": 8,
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#2563EB",
          "defaultChannel": "falcon-default"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Falcon Attendance to use your location to verify you are inside the office."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-sharing",
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Falcon Attendance to access your photos to set your profile picture.",
          "cameraPermission": "Allow Falcon Attendance to access your camera to take a profile picture."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "8542a6b4-323b-4bac-b3e8-42a5ba83b624"
      }
    }
  }
}
