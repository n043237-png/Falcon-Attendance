{
  "expo": {
    "name": "Falcon Attendance",
    "slug": "falcon-attendance",
    "version": "1.0.8",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.falconinfo.attendance",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Falcon Attendance requires your location to verify you are inside the office premises during check-in and check-out.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.falconinfo.attendance",
      "versionCode": 9,
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#2563EB",
          "defaultChannel": "falcon-default"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Falcon Attendance to use your location to verify you are inside the office."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-sharing",
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Falcon Attendance to access your photos to set your profile picture.",
          "cameraPermission": "Allow Falcon Attendance to access your camera to take a profile picture."
        }
      ]
    ],
    "owner": "aman1234567890s-team",
    "extra": {
      "eas": {
        "projectId": "5db1250c-a74c-4d1d-8553-9f60acbaeee0"
      }
    }
  }
}
